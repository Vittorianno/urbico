# Urbico Development Configuration
# Este arquivo foi gerado para teste via Expo Go

# Backend
PORT=3000

# Banco de dados (opcional para test)
# DATABASE_URL=mysql://usuario:senha@localhost:3306/urbico

# Autenticação JWT
JWT_SECRET=dev-secret-key-change-in-production-12345678901234567890

# OAuth (desativado em dev - app funciona sem login)
# OAUTH_SERVER_URL=
# VITE_APP_ID=
# OWNER_OPEN_ID=
# OWNER_NAME=
# VITE_OAUTH_PORTAL_URL=

# SPTrans
# SPTRANS_TOKEN=seu-token-aqui

# Geocodificação e Rotas (opcional)
# PELIAS_BASE_URL=
# VALHALLA_BASE_URL=

# Norby / LLM (opcional)
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Legado Manus (não usado)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Cliente (Expo)
EXPO_PORT=8081
# EXPO_PUBLIC_API_BASE_URL será derivada do hostname em dev
