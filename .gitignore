# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Este projeto usa pnpm (ver packageManager em package.json e node-linker em
# .npmrc). Lockfiles de outros gerenciadores não devem ser commitados — já
# aconteceu um package-lock.json parar aqui por engano, coexistindo com o
# pnpm-lock.yaml e arriscando resolução de dependências divergente.
package-lock.json
yarn.lock

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# ---------------------------------------------------------------------------
# SEGREDOS — chaves de API, tokens e senhas vivem SOMENTE no .env (local).
# Nada abaixo pode ser commitado. Veja docs/SEGREDOS.md e
# scripts/check-secrets.mjs (roda no pre-commit, no pre-push e no GitHub).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.envrc

# Configurações do Firebase/Google trazem chave de API: ficam fora do Git.
google-services.json
GoogleService-Info.plist

# Credenciais de conta de serviço e arquivos de login locais.
service-account*.json
*-service-account*.json
credentials.json
.git-credentials

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
# A pasta android/ nativa gerada pelo Expo é versionada.

# IDE
.vscode/*
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# OS
Thumbs.db

# Build files
*.tgz
*.tar.gz
.cache/

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
.project-config.json
