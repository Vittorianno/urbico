# Copie este arquivo para ".env" e preencha com seus próprios valores.
# NUNCA coloque valores reais deste arquivo no Git — .env já está no .gitignore.

# ---------------------------------------------------------------------------
# Backend / servidor (server/_core/env.ts)
# ---------------------------------------------------------------------------

# Porta do servidor Express. Se estiver ocupada, o servidor sobe automaticamente
# na próxima porta livre (3000, 3001, 3002...).
PORT=3000

# String de conexão MySQL usada pelo Drizzle ORM e por "pnpm db:push".
# Sem isto configurado, o app ainda inicia — ele apenas roda sem persistência
# (login não é salvo, alertas de saída e relatos de lotação não funcionam).
DATABASE_URL=mysql://usuario:senha@localhost:3306/urbico

# Segredo usado para assinar o cookie/token de sessão (JWT). Gere uma string
# aleatória longa e única por ambiente, ex.: `openssl rand -base64 48`.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Autenticação (OAuth) — server/_core/sdk.ts, server/_core/oauth.ts
# ---------------------------------------------------------------------------
# IMPORTANTE: o login do Urbico hoje depende de um servidor OAuth compatível
# com o protocolo específico do Manus (não é Google/Apple/GitHub OAuth
# padrão). Se você não tiver esse servidor, o login não funcionará até que a
# autenticação seja migrada para um provedor próprio ou padrão. Veja o README
# ("Autenticação") para mais contexto.

# URL do servidor OAuth.
OAUTH_SERVER_URL=

# Identificador do app registrado nesse servidor OAuth.
VITE_APP_ID=

# openId do dono/administrador do projeto (usado para conceder papel "admin").
OWNER_OPEN_ID=

# Nome de exibição do dono do projeto (opcional).
OWNER_NAME=

# URL do portal de login (tela hospedada de sign-in), usada pelo cliente.
VITE_OAUTH_PORTAL_URL=

# ---------------------------------------------------------------------------
# SPTrans Olho Vivo — server/integrations/sptrans.ts
# ---------------------------------------------------------------------------
# Token de desenvolvedor obtido em http://www.sptrans.com.br/desenvolvedores/
# Fica só no backend — nunca é enviado ao cliente/app.
SPTRANS_TOKEN=

# ---------------------------------------------------------------------------
# Geocodificação e rotas a pé — server/integrations/open-geospatial.ts
# ---------------------------------------------------------------------------
# Ambos opcionais. Sem eles configurados, o app funciona normalmente: busca de
# endereço automática e cálculo de rota a pé ficam indisponíveis (fallback
# gracioso, sem quebrar o app), e o compromisso pode ser salvo com endereço
# digitado manualmente.

# URL de uma instância própria do Pelias (geocodificação / busca de endereço).
PELIAS_BASE_URL=

# URL de uma instância própria do Valhalla (cálculo de rota a pé).
VALHALLA_BASE_URL=

# ---------------------------------------------------------------------------
# Norby (assistente) — server/integrations/norby.ts
# ---------------------------------------------------------------------------
# Ambos opcionais. Sem eles configurados, o Norby usa respostas locais
# baseadas em regras (lib/urbico-logic.ts) em vez de um modelo de linguagem.

# URL base de uma instância do Ollama (ex.: http://localhost:11434).
OLLAMA_BASE_URL=

# Nome do modelo Ollama a usar (ex.: llama3.1).
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# Legado do template Manus — opcional, só necessário se você ainda usa esses
# recursos específicos da plataforma Manus (notificação ao dono via
# server/_core/notification.ts, geração de imagem, transcrição de voz,
# proxy de armazenamento). Nenhuma funcionalidade do Urbico em uso depende
# destas variáveis hoje. Veja o README ("Dependências legadas") antes de
# remover os arquivos correspondentes.
# ---------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Cliente Expo (variáveis EXPO_PUBLIC_* — vão para o bundle, nunca coloque
# segredos aqui). Normalmente preenchidas automaticamente a partir das
# variáveis do servidor acima por scripts/load-env.js; defina manualmente só
# se precisar de um valor diferente no cliente.
# ---------------------------------------------------------------------------

# Porta do Metro bundler (padrão 8081).
EXPO_PORT=8081

# URL base da API que o app (web/Android/iOS) deve chamar. Em desenvolvimento
# web costuma ser derivada automaticamente do hostname; defina explicitamente
# para builds nativos e produção, ex.: https://api.seudominio.com
EXPO_PUBLIC_API_BASE_URL=
